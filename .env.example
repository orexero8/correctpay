# ------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------

# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://payments:payments@localhost:5432/payments

# Redis
REDIS_URL=redis://localhost:6379

# Fastify
CORS_ORIGIN=http://localhost:8080

# Active payment provider ("mock" until the official CIB package arrives)
ACTIVE_PROVIDER=mock

# Mock adapter (local testing only)
MOCK_ADAPTER_ENABLED=true
# Public base URL of this service; used to build the fake checkout redirect URL.
MOCK_ADAPTER_BASE_URL=http://localhost:3000
# Where the fake provider signs+POSTs its callback. The receiving webhook
# route is implemented in Phase 5.
MOCK_WEBHOOK_TARGET_URL=http://localhost:3000/v1/webhooks/mock
# HMAC signing secret for the fake webhook callbacks signed by the mock provider.
# Generate with: openssl rand -hex 32
MOCK_WEBHOOK_SECRET=replace-with-at-least-32-random-hex-chars

# CIB adapter is NOT_IMPLEMENTED until the official technical package arrives.
# Do not configure real CIB secrets before Phase 7.